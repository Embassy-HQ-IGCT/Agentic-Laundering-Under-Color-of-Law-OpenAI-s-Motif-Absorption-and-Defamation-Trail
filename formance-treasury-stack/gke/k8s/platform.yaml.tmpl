# Rendered by gke-deploy.sh with envsubst. Secrets are created by the script from Secret Manager, never stored here.
apiVersion: v1
kind: Namespace
metadata:
  name: ${NAMESPACE}
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: ${KSA}
  namespace: ${NAMESPACE}
  annotations:
    iam.gke.io/gcp-service-account: ${APP_GSA}
---
# ------------------------------------------------------------ Temporal (workflow engine for Formance Payments)
apiVersion: apps/v1
kind: Deployment
metadata: { name: temporal, namespace: ${NAMESPACE} }
spec:
  replicas: 1
  selector: { matchLabels: { app: temporal } }
  template:
    metadata: { labels: { app: temporal } }
    spec:
      serviceAccountName: ${KSA}
      containers:
        - name: temporal
          image: temporalio/auto-setup:1.29.1
          ports: [{ containerPort: 7233 }]
          env:
            - { name: DB, value: postgres12 }
            - { name: DB_PORT, value: "5432" }
            - { name: POSTGRES_SEEDS, value: "${SQL_IP}" }
            - { name: POSTGRES_USER, value: temporal }
            - { name: DBNAME, value: temporal }
            - { name: VISIBILITY_DBNAME, value: temporal_visibility }
            - name: POSTGRES_PWD
              valueFrom: { secretKeyRef: { name: db-passwords, key: temporal } }
          resources: { requests: { cpu: 500m, memory: 1Gi } }
---
apiVersion: v1
kind: Service
metadata: { name: temporal, namespace: ${NAMESPACE} }
spec:
  selector: { app: temporal }
  ports: [{ port: 7233, targetPort: 7233 }]
---
# ------------------------------------------------------------ Formance Payments (community)
apiVersion: batch/v1
kind: Job
metadata: { name: payments-migrate, namespace: ${NAMESPACE} }
spec:
  backoffLimit: 4
  template:
    spec:
      restartPolicy: OnFailure
      serviceAccountName: ${KSA}
      containers:
        - name: migrate
          image: ${PAYMENTS_IMAGE}
          args: ["migrate", "up"]
          env:
            - name: POSTGRES_URI
              valueFrom: { secretKeyRef: { name: app-secrets, key: payments-postgres-uri } }
---
apiVersion: apps/v1
kind: Deployment
metadata: { name: payments-server, namespace: ${NAMESPACE} }
spec:
  replicas: 2
  selector: { matchLabels: { app: payments-server } }
  template:
    metadata: { labels: { app: payments-server } }
    spec:
      serviceAccountName: ${KSA}
      containers:
        - name: payments
          image: ${PAYMENTS_IMAGE}
          args: ["server"]
          ports: [{ containerPort: 8080 }]
          envFrom: [{ secretRef: { name: payments-env } }]
          env:
            - { name: TEMPORAL_ADDRESS, value: "temporal:7233" }
            - { name: TEMPORAL_INIT_SEARCH_ATTRIBUTES, value: "true" }
            - { name: STACK_PUBLIC_URL, value: "${PAYMENTS_PUBLIC_URL}" }
          readinessProbe: { httpGet: { path: /_healthcheck, port: 8080 } }
          livenessProbe: { httpGet: { path: /_healthcheck, port: 8080 }, initialDelaySeconds: 20 }
          resources: { requests: { cpu: 250m, memory: 512Mi } }
---
apiVersion: apps/v1
kind: Deployment
metadata: { name: payments-worker, namespace: ${NAMESPACE} }
spec:
  replicas: 2
  selector: { matchLabels: { app: payments-worker } }
  template:
    metadata: { labels: { app: payments-worker } }
    spec:
      serviceAccountName: ${KSA}
      containers:
        - name: worker
          image: ${PAYMENTS_IMAGE}
          args: ["worker", "--listen", ":8082", "--profiler-listen", ":9191"]
          envFrom: [{ secretRef: { name: payments-env } }]
          env:
            - { name: TEMPORAL_ADDRESS, value: "temporal:7233" }
            - { name: STACK_PUBLIC_URL, value: "${PAYMENTS_PUBLIC_URL}" }
          readinessProbe: { httpGet: { path: /_healthcheck, port: 8082 } }
          resources: { requests: { cpu: 250m, memory: 512Mi } }
---
apiVersion: v1
kind: Service
metadata: { name: payments, namespace: ${NAMESPACE} }
spec:
  selector: { app: payments-server }
  ports: [{ port: 8080, targetPort: 8080 }]
---
# ------------------------------------------------------------ Formance Ledger v3 (single Raft node; add voters for HA)
apiVersion: apps/v1
kind: StatefulSet
metadata: { name: ledger, namespace: ${NAMESPACE} }
spec:
  serviceName: ledger
  replicas: 1
  selector: { matchLabels: { app: ledger } }
  template:
    metadata: { labels: { app: ledger } }
    spec:
      serviceAccountName: ${KSA}
      containers:
        - name: ledger
          image: ${LEDGER_IMAGE}
          args:
            - run
            - --node-id=1
            - --cluster-id=${LEDGER_CLUSTER_ID}
            - --bootstrap
            - --bind-addr=0.0.0.0:7777
            - --grpc-port=8888
            - --http-port=9000
            - --wal-dir=/data/wal
            - --data-dir=/data/db
          ports: [{ containerPort: 8888 }, { containerPort: 9000 }, { containerPort: 7777 }]
          volumeMounts: [{ name: data, mountPath: /data }]
          resources: { requests: { cpu: 500m, memory: 1Gi } }
  volumeClaimTemplates:
    - metadata: { name: data }
      spec:
        accessModes: ["ReadWriteOnce"]
        resources: { requests: { storage: ${LEDGER_DISK_GI}Gi } }
---
apiVersion: v1
kind: Service
metadata: { name: ledger, namespace: ${NAMESPACE} }
spec:
  clusterIP: None
  selector: { app: ledger }
  ports: [{ name: grpc, port: 8888 }, { name: http, port: 9000 }]
---
# ------------------------------------------------------------ Treasury engine (card auth, payouts, FX, credit, recon, Rafiki intake)
# SINGLE REPLICA + SQLite on a PVC: operational state (payout/auth records, card controls) is NOT highly available yet.
# Money balances live in the Ledger; move this state to Postgres before running more than one replica.
apiVersion: apps/v1
kind: StatefulSet
metadata: { name: treasury-engine, namespace: ${NAMESPACE} }
spec:
  serviceName: treasury-engine
  replicas: 1
  selector: { matchLabels: { app: treasury-engine } }
  template:
    metadata: { labels: { app: treasury-engine } }
    spec:
      serviceAccountName: ${KSA}
      containers:
        - name: engine
          image: ${ENGINE_IMAGE}
          ports: [{ containerPort: 8200 }]
          env:
            - { name: LEDGER_URL, value: "http://ledger-0.ledger:9000" }
            - { name: LEDGER_NAME, value: "treasury" }
            - { name: DB_PATH, value: "/data/treasury.db" }
            - { name: PORT, value: "8200" }
            - { name: TREASURY_ALLOW_MOCK_BANKS, value: "${ALLOW_MOCK_BANKS}" }
          volumeMounts: [{ name: state, mountPath: /data }]
          readinessProbe: { httpGet: { path: /health, port: 8200 } }
          resources: { requests: { cpu: 250m, memory: 256Mi } }
  volumeClaimTemplates:
    - metadata: { name: state }
      spec:
        accessModes: ["ReadWriteOnce"]
        resources: { requests: { storage: 5Gi } }
---
apiVersion: v1
kind: Service
metadata: { name: treasury-engine, namespace: ${NAMESPACE} }
spec:
  selector: { app: treasury-engine }
  ports: [{ port: 8200, targetPort: 8200 }]
---
# ------------------------------------------------------------ (legacy) Rafiki -> Ledger bridge; superseded by the engine's /rafiki/webhooks
apiVersion: apps/v1
kind: Deployment
metadata: { name: rafiki-ledger-bridge, namespace: ${NAMESPACE} }
spec:
  replicas: 2
  selector: { matchLabels: { app: rafiki-ledger-bridge } }
  template:
    metadata: { labels: { app: rafiki-ledger-bridge } }
    spec:
      serviceAccountName: ${KSA}
      containers:
        - name: bridge
          image: ${BRIDGE_IMAGE}
          ports: [{ containerPort: 3100 }]
          env:
            - { name: LEDGER_SERVER, value: "ledger-0.ledger:8888" }
            - { name: LEDGER_NAME, value: "rafiki" }
            - { name: BRIDGE_PORT, value: "3100" }
          readinessProbe: { httpGet: { path: /rates, port: 3100 } }
          resources: { requests: { cpu: 100m, memory: 128Mi } }
---
apiVersion: v1
kind: Service
metadata: { name: rafiki-ledger-bridge, namespace: ${NAMESPACE} }
spec:
  selector: { app: rafiki-ledger-bridge }
  ports: [{ port: 3100, targetPort: 3100 }]
